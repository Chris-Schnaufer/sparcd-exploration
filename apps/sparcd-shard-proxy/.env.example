# Copy to `.env` next to compose.yaml.

# The S3 endpoint being fronted, with scheme and port.
UPSTREAM=https://js2.jetstream-cloud.org:8001

# The hostname clients reach this proxy on. Caddy issues its certificate for
# this name (and for every name in SHARD_ADDRESSES), so DNS must already point
# here before the first start.
PROXY_DOMAIN=proxy.example.org

# The extra origins clients stripe across, comma-separated. Ports must match
# the published ports in compose.yaml. Subdomains on :443 work too — see the
# README on picking ports versus subdomains.
SHARD_ADDRESSES=proxy.example.org:8443, proxy.example.org:8444, proxy.example.org:8445
