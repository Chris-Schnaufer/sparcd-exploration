# The canonical shard-proxy config. One file serves local dev, any VM, and the
# Jetstream2 deploy; everything site-specific arrives in the environment.
#
#   UPSTREAM         scheme://host:port of the S3 endpoint being fronted
#                    e.g. https://js2.jetstream-cloud.org:8001
#   PROXY_DOMAIN     hostname clients reach this proxy on — the :443 origin
#   SHARD_ADDRESSES  the extra origins, comma-separated
#                    e.g. "proxy.example.org:8443, proxy.example.org:8444"
#
# Caddy substitutes {$VAR} textually before parsing, so SHARD_ADDRESSES may
# hold as many addresses as the deployment publishes ports for, and the shards
# may be subdomains on :443 instead of ports (see README).
#
# HTTPS and HTTP/3 are automatic: Caddy issues public certificates via ACME for
# real hostnames and internal ones for `localhost`, and advertises h3 on every
# TLS listener. h3 only reaches clients if the deployment publishes each shard
# port over UDP as well as TCP.

(s3shard) {
	# The upstream recomputes the SigV4 signature from the request it receives,
	# and Host is one of the signed headers, so the client's Host must arrive
	# byte-identical. Browsers omit the port when it is the scheme default, so
	# the :443 site passes {host} (portless) and the shard sites pass
	# {http.request.hostport} (host:port). Caddy preserves Host by default;
	# pinning it here keeps the widely cargo-culted
	# `header_up Host {upstream_hostport}` — which silently breaks every
	# signature — from creeping in.
	@preflight method OPTIONS
	handle @preflight {
		# The proxy owns CORS. Ceph RGW answers CORS per bucket only, so
		# service-level calls (ListBuckets, the uploader's collection
		# discovery) are browser-dead without this.
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, HEAD, PUT, POST, DELETE"
		header Access-Control-Allow-Headers "authorization, content-type, if-match, if-none-match, range, amz-sdk-invocation-id, amz-sdk-request, x-amz-content-sha256, x-amz-date, x-amz-meta-sha256, x-amz-user-agent, x-amz-checksum-crc32, x-amz-checksum-sha256, x-amz-checksum-mode, x-amz-sdk-checksum-algorithm, x-amz-security-token, x-amz-decoded-content-length, x-amz-trailer"
		header Access-Control-Max-Age "600"
		header Vary "Origin"
		respond "" 204
	}
	log
	handle {
		header {
			Access-Control-Allow-Origin "{http.request.header.Origin}"
			Access-Control-Expose-Headers "ETag, Content-Length, x-amz-meta-sha256, x-amz-request-id, x-amz-version-id"
			Vary "Origin"
		}
		reverse_proxy {$UPSTREAM} {
			header_up Host {args[0]}

			# HTTP/3 requests carry no Content-Length. Unbuffered, Caddy
			# forwards them to the HTTP/1.1 upstream as
			# `Transfer-Encoding: chunked`, which RGW rejects with
			# 501 NotImplemented. Buffering lets Caddy set a real length.
			request_buffers 16KiB

			# RGW emits its own per-bucket CORS headers. Dropping them here is
			# what keeps the browser from seeing two Access-Control-Allow-Origin
			# values and failing the check.
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Expose-Headers
			header_down -Access-Control-Max-Age
		}
	}
}

{$PROXY_DOMAIN}:443 {
	import s3shard {host}
}

{$SHARD_ADDRESSES} {
	import s3shard {http.request.hostport}
}
